    { "id": "golan-08", "speaker": "golan", "text": "אפשר לסמוך על הדמוקרטים", "year": 2026, "context": "סלוגן", "level": 1, "confusableWith": ["eisenkot"], "source": "https://www.ynet.co.il/news/elections2026/article/s1tmolrqge" },
    { "id": "golan-09", "speaker": "golan", "text": "זה לא הזמן לריבים פנימיים, אלא הזמן לנצח", "year": 2026, "context": "קמפיין", "level": 1, "confusableWith": [], "source": "https://www.mako.co.il/news-israel-elections/2026/Article-ec4ac22a5157c91026.htm" },
    { "id": "golan-10", "speaker": "golan", "text": "ועכשיו הגיע הרגע שלנו", "year": 2026, "context": "פנייה לבוחרים", "level": 1, "confusableWith": [], "source": "https://www.ynet.co.il/news/elections2026/article/h1qbon52fe" },

