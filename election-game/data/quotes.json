    { "id": "bengvir-07", "speaker": "bengvir", "text": "מדינת ישראל צריכה בן גביר חזק, וביבי צריך בן גביר חזק", "year": 2026, "context": "סוף הקמפיין", "level": 2, "confusableWith": [], "source": "https://www.ynet.co.il/news/elections2026/article/s1cfo1nngl" },
    { "id": "bengvir-08", "speaker": "bengvir", "text": "בסוף כולם מודים שצדקתי", "year": 2026, "context": "פנייה לבוחרים", "level": 2, "confusableWith": [], "source": "https://www.ynet.co.il/news/elections2026/article/h1qbon52fe" },
    { "id": "bengvir-09", "speaker": "bengvir", "text": "שיפסיקו עם האגו, גם של המפכ\"ל וגם של שר הבט\"פ", "year": 2022, "context": "שייח' ג'ראח, לפני שהוא עצמו הפך לשר", "level": 1, "confusableWith": [], "source": "https://www.jdn.co.il/news/1695838/" },
    { "id": "bengvir-10", "speaker": "bengvir", "text": "הסלוגן מטריד מאוד ומשקף את כוונת ראש הממשלה להקים ממשלה עם איזנקוט", "year": 2026, "context": "על סלוגן הליכוד", "level": 1, "confusableWith": ["smotrich"], "source": "https://www.ynet.co.il/news/article/b1iutpu8fx" },

