    { "id": "bengvir-05", "speaker": "bengvir", "text": "לא מתנצל ולא חוזר בי מדבריי. אגיד אותם גם עוד אלף פעם", "year": 2023, "context": "על אותה אמירה", "level": 1, "confusableWith": [], "source": "https://www.makorrishon.co.il/news/659643/" },
