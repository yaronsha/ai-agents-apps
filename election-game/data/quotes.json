    { "id": "golan-02", "speaker": "golan", "text": "מדינה שפויה לא הורגת תינוקות כתחביב", "year": 2025, "context": "ראיון רדיו", "level": 3, "confusableWith": [], "source": "https://www.kan.org.il/content/kan-news/politic/908253/", "sensitive": true, "audio": "assets/audio/golan-02.mp3" },
    { "id": "golan-03", "speaker": "golan", "text": "הם תתי אדם", "year": 2022, "context": "על מתנחלים שתקפו בבורקה", "level": 2, "confusableWith": ["smotrich", "bengvir"], "source": "https://www.walla.co.il/news/politics/3751133" },
    { "id": "golan-04", "speaker": "golan", "text": "אנחנו לא עושים מילואים עד שהממשלה לא מתחלפת", "year": 2025, "context": "קריאה לאי ציות אזרחי", "level": 2, "confusableWith": [], "source": "https://www.walla.co.il/news/politics/3751133" },
    { "id": "golan-05", "speaker": "golan", "text": "ביביסטן נחשלת או ישראל דמוקרטית וחזקה", "year": 2026, "context": "סלוגן", "level": 2, "confusableWith": [], "source": "https://www.ynet.co.il/news/elections2026/article/s1cfo1nngl" },
    { "id": "golan-06", "speaker": "golan", "text": "קמפיין המפלגה הגדולה הוא טעות. זה שקר מסוכן", "year": 2026, "context": "26.10.2026", "level": 1, "confusableWith": ["bennett", "lapid"], "source": "https://www.walla.co.il/news/politics/383958958" },
