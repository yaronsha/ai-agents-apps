    { "id": "bengvir-02", "speaker": "bengvir", "text": "אנחנו בעלי הבית על המדינה ובעלי הבית על ירושלים", "year": 2022, "context": "שייח' ג'ראח", "level": 3, "confusableWith": ["smotrich"], "source": "https://www.jdn.co.il/news/1695838/" },
