{
  "name": "thailand-trip",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "app",
    "worker",
    "sim"
  ],
  "scripts": {
    "postinstall": "node shared/scripts/ensure-private.mjs",
    "dev": "npm run dev -w app",
    "dev:worker": "npm run dev -w worker",
    "build": "npm run build -w app",
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p app --noEmit && tsc -p worker --noEmit && tsc -p sim",
    "lint": "eslint worker shared app",
    "check": "npm run typecheck && npm test && npm run lint && npm run sim",
    "sim": "npm run sim -w sim --",
    "verify:places": "npm run places -w sim",
    "check:free": "npm run check:free -w sim --",
    "check:paid": "npm run check:paid -w sim --",
    "check:live": "npm run check:free && npm run check:paid",
    "shadow:report": "npm run shadow:report -w sim --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@trip/sim": {
      "miniflare": {
        "workerd": "^1.20261001.1"
      }
    }
  }
}
