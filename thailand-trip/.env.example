# Keys for the local live checks (npm run check:paid). Copy to .env and fill in.
# .env is git-ignored. Never commit real keys: this repository is public.
# Free sources (npm run check:free) need nothing from this file.

# OpenAI: news triage and "re-plan for me" (AI_PROVIDER = "openai").
OPENAI_API_KEY=
# Optional: Claude, only if you also want to compare it.
ANTHROPIC_API_KEY=

# Google Maps Platform key with the Routes API enabled (live drive times).
GOOGLE_MAPS_KEY=

# RapidAPI key subscribed to AeroDataBox (flight status).
RAPIDAPI_KEY=
# A real flight in the next few days to probe AeroDataBox with, like: EY 432 2026-10-20
LIVE_FLIGHT=

# Shadow-mode report (npm run shadow:report): the app's address (it passes /api on to the worker) and the access code.
WORKER_URL=https://thailand-trip-app.pages.dev
# Optional: leave empty and the report asks for it.
APP_TOKEN=
